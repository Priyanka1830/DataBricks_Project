            or
            ((not snapshotted_data.`fulfillment_channel` is null) and (source_data.`fulfillment_channel` is null))
        ))
        )
    )

    select * from insertions
    union all
    select * from updates

    ) as __dbt_sbq
    where false
    limit 0

